(= (conflict-level (stv $s1 $c1) (stv $s2 $c2)) (abs (- $s1 $s2)))
(= (revision (stv $s1 $c1) (stv $s2 $c2))
   (if (and (valid-stv (stv $s1 $c1)) (valid-stv (stv $s2 $c2)))
       (let* (($w1 (c2w $c1)) ($w2 (c2w $c2)) ($w (+ $w1 $w2)))
          (if (== $w 0.0) (stv 0.5 0.0)
              (stv (/ (+ (* $w1 $s1) (* $w2 $s2)) $w) (w2c $w))))
       (Error InvalidSTV revision)))
(= (modus-ponens (stv $sA $cA) (stv $sBA $cBA))
   (if (and (valid-stv (stv $sA $cA)) (valid-stv (stv $sBA $cBA)))
       (stv (+ (* $sA $sBA) (* (- 1.0 $sA) 0.02))
            (* (* $sA $sBA) (* $cA $cBA)))
       (Error InvalidSTV modus-ponens)))
(= (relationship-deduction (stv $pAB $cAB) (stv $pBC $cBC)
       (stv $pA $cA) (stv $pB $cB) (stv $pC $cC))
   (if (and (and (valid-stv (stv $pAB $cAB)) (valid-stv (stv $pBC $cBC)))
            (and (valid-stv (stv $pA $cA))
                 (and (valid-stv (stv $pB $cB)) (valid-stv (stv $pC $cC)))))
       (if (and (conditional-consistent $pA $pB $pAB)
                (conditional-consistent $pB $pC $pBC))
           (if (>= $pB 1.0) (Error UndefinedConditional relationship-deduction)
               (let $background (/ (- $pC (* $pB $pBC)) (- 1.0 $pB))
                  (stv (+ (* $pAB $pBC) (* (- 1.0 $pAB) $background))
                       (* (* $pAB $pBC) (* $cAB $cBC)))))
           (Error InconsistentProbabilities relationship-deduction))
       (Error InvalidSTV relationship-deduction)))
(= (induction (stv $pAC $cAC) (stv $pBC $cBC)
       (stv $pC $cC) (stv $pA $cA) (stv $pB $cB))
   (if (and (and (valid-stv (stv $pAC $cAC)) (valid-stv (stv $pBC $cBC)))
            (and (valid-stv (stv $pC $cC))
                 (and (valid-stv (stv $pA $cA)) (valid-stv (stv $pB $cB)))))
       (if (and (and (> $pA 0.0) (< $pC 1.0))
                (and (conditional-consistent $pC $pA $pAC)
                     (conditional-consistent $pC $pB $pBC)))
           (let* (($pAoutside (/ (- $pA (* $pC $pAC)) (- 1.0 $pC)))
                  ($pBoutside (/ (- $pB (* $pC $pBC)) (- 1.0 $pC)))
                  ($joint (+ (* (* $pAC $pBC) $pC)
                             (* (* $pAoutside $pBoutside) (- 1.0 $pC)))))
               (stv (/ $joint $pA)
                    (* (w2c (* (* $pBC $cBC) $cAC)) (* (* $cC $cA) $cB))))
           (Error InconsistentProbabilities induction))
       (Error InvalidSTV induction)))
(= (abduction (stv $q $cq) (stv $pBA $cBA)
       (stv $pA $cA) (stv $pB $cB))
   (if (and (and (valid-stv (stv $q $cq)) (valid-stv (stv $pBA $cBA)))
            (and (valid-stv (stv $pA $cA)) (valid-stv (stv $pB $cB))))
       (if (and (and (> $pB 0.0) (< $pB 1.0))
                (conditional-consistent $pA $pB $pBA))
           (let* (($positive (/ (* $pA $pBA) $pB))
                  ($negative (/ (* $pA (- 1.0 $pBA)) (- 1.0 $pB))))
               (stv (+ (* $q $positive) (* (- 1.0 $q) $negative))
                    (* (w2c (* (* $pBA $cBA) $cq)) (* $cA $cB))))
           (Error InconsistentProbabilities abduction))
       (Error InvalidSTV abduction)))
